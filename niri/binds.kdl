include "noctalia/binds.kdl"

gestures {
    hot-corners {
        off
    }
}

binds {
    /***************************************************************************
    * Run <commands>
    ***************************************************************************/
    Mod+Shift+P repeat=false hotkey-overlay-title="Pick color"        { spawn-sh "niri msg pick-color | wl-copy"; }
    Mod+T       repeat=false hotkey-overlay-title="Open Terminal"     { spawn    "wezterm"; }
    Mod+B       repeat=false hotkey-overlay-title="Open Browser"      { spawn-sh "firefox"; }
    Mod+E       repeat=false hotkey-overlay-title="Open File Manager" { spawn    "nautilus"; }
    Mod+Shift+Slash                                                   { show-hotkey-overlay; }
    Mod+Alt+Delete                                                    { quit; }


    /***************************************************************************
    * Harpoon: Mod+number jumps; Mod+Shift+number marks/replaces
    ***************************************************************************/
    Mod+1 repeat=false       hotkey-overlay-title=null { spawn "niri-harpoon" "jump" "1"; }
    Mod+Shift+1 repeat=false hotkey-overlay-title=null { spawn "niri-harpoon" "mark" "1"; }

    Mod+2 repeat=false       hotkey-overlay-title=null { spawn "niri-harpoon" "jump" "2"; }
    Mod+Shift+2 repeat=false hotkey-overlay-title=null { spawn "niri-harpoon" "mark" "2"; }

    Mod+3 repeat=false       hotkey-overlay-title=null { spawn "niri-harpoon" "jump" "3"; }
    Mod+Shift+3 repeat=false hotkey-overlay-title=null { spawn "niri-harpoon" "mark" "3"; }

    Mod+4 repeat=false       hotkey-overlay-title=null { spawn "niri-harpoon" "jump" "4"; }
    Mod+Shift+4 repeat=false hotkey-overlay-title=null { spawn "niri-harpoon" "mark" "4"; }

    Mod+5 repeat=false       hotkey-overlay-title=null { spawn "niri-harpoon" "jump" "5"; }
    Mod+Shift+5 repeat=false hotkey-overlay-title=null { spawn "niri-harpoon" "mark" "5"; }

    Mod+6 repeat=false       hotkey-overlay-title=null { spawn "niri-harpoon" "jump" "6"; }
    Mod+Shift+6 repeat=false hotkey-overlay-title=null { spawn "niri-harpoon" "mark" "6"; }

    Mod+7 repeat=false       hotkey-overlay-title=null { spawn "niri-harpoon" "jump" "7"; }
    Mod+Shift+7 repeat=false hotkey-overlay-title=null { spawn "niri-harpoon" "mark" "7"; }

    Mod+8 repeat=false       hotkey-overlay-title=null { spawn "niri-harpoon" "jump" "8"; }
    Mod+Shift+8 repeat=false hotkey-overlay-title=null { spawn "niri-harpoon" "mark" "8"; }

    Mod+9 repeat=false       hotkey-overlay-title=null { spawn "niri-harpoon" "jump" "9"; }
    Mod+Shift+9 repeat=false hotkey-overlay-title=null { spawn "niri-harpoon" "mark" "9"; }


    /***************************************************************************
    * Window & Layout
    ***************************************************************************/
    Mod+O repeat=false { toggle-overview; }
    Mod+Q repeat=false { close-window; }
    Mod+V              { toggle-window-floating; }
    Mod+Shift+V        { switch-focus-between-floating-and-tiling; }
    Mod+W              { toggle-column-tabbed-display; }
    Mod+C              { center-column; }
    Mod+Ctrl+C         { center-visible-columns; }


    /***************************************************************************
    * Screenshots & Cast
    ***************************************************************************/
    Print       hotkey-overlay-title="Screenshot"            { screenshot        show-pointer=false; }
    Alt+Print   hotkey-overlay-title="Screenshot: Window"    { screenshot-window show-pointer=false; }
    Ctrl+Print  hotkey-overlay-title="Screenshot: Screen"    { screenshot-screen show-pointer=false; }
    Mod+S       hotkey-overlay-title="Screenshot"            { screenshot        show-pointer=false; }
    Mod+Alt+S   hotkey-overlay-title="Screenshot: Window"    { screenshot-window show-pointer=false; }
    Mod+Ctrl+S  hotkey-overlay-title="Screenshot: Screen"    { screenshot-screen show-pointer=false; }

    Mod+Shift+W hotkey-overlay-title="Cast: Select Window"   { set-dynamic-cast-window; }
    Mod+Shift+M hotkey-overlay-title="Cast: Select Monitor"  { set-dynamic-cast-monitor; }
    Mod+Shift+X hotkey-overlay-title="Cast: Clear Selection" { clear-dynamic-cast-target; }


    /***************************************************************************
    * Resize <window|column>
    ***************************************************************************/
    Mod+Minus        { set-column-width "-1%"; }
    Mod+Equal        { set-column-width "+1%"; }
    Mod+Shift+Minus  { set-window-height "-1%"; }
    Mod+Shift+Equal  { set-window-height "+1%"; }

    Mod+R            { switch-preset-column-width; }
    Mod+Shift+R      { switch-preset-window-height; }

    Mod+F            { maximize-column; }
    Mod+Ctrl+F       { expand-column-to-available-width; }
    Mod+Ctrl+R       { reset-window-height; }

    Mod+Shift+F      { fullscreen-window; }
    // Mod+Ctrl+Shift+F { maximize-window-to-edges; }
    // Toggle windowed (fake) fullscreen on the focused window:
    Mod+Ctrl+Shift+F { toggle-windowed-fullscreen; }


    /***************************************************************************
    * Focus <window|column>
    ***************************************************************************/
    Mod+Up                                    { focus-window-up; }
    Mod+K                                     { focus-window-up/*-or-bottom*/; }
    Mod+Down                                  { focus-window-down; }
    Mod+J                                     { focus-window-down/*-or-top*/; }

    Mod+Home                                  { focus-column-first; }
    Mod+BracketLeft                           { focus-column-first; }
    Mod+End                                   { focus-column-last; }
    Mod+BracketRight                          { focus-column-last; }
    Mod+Left                                  { focus-column-left; }
    Mod+H                                     { focus-column-left; }
    Mod+Shift+WheelScrollUp   cooldown-ms=150 { focus-column-left; }
    Mod+Right                                 { focus-column-right; }
    Mod+L                                     { focus-column-right; }
    Mod+Shift+WheelScrollDown cooldown-ms=150 { focus-column-right; }


    /***************************************************************************
    * Move <window|column>
    ***************************************************************************/
    Mod+Ctrl+Up                                    { move-window-up; }
    Mod+Ctrl+K                                     { move-window-up/*-or-to-workspace-up*/; }
    Mod+Ctrl+Down                                  { move-window-down; }
    Mod+Ctrl+J                                     { move-window-down/*-or-to-workspace-down*/; }
    Mod+Ctrl+Left                                  { consume-or-expel-window-left; }
    Mod+Ctrl+H                                     { consume-or-expel-window-left; }
    Mod+Ctrl+Right                                 { consume-or-expel-window-right; }
    Mod+Ctrl+L                                     { consume-or-expel-window-right; }

    Mod+Ctrl+Home                                  { move-column-to-first; }
    Mod+Ctrl+BracketLeft                           { move-column-to-first; }
    Mod+Ctrl+End                                   { move-column-to-last; }
    Mod+Ctrl+BracketRight                          { move-column-to-last; }
    Mod+Apostrophe                                 { move-column-left; }
    Mod+Ctrl+Shift+WheelScrollUp   cooldown-ms=150 { move-column-left; }
    Mod+Period                                     { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollDown cooldown-ms=150 { move-column-right; }


    /***************************************************************************
    * Focus <workspace>
    ***************************************************************************/
    // Mod+Tab { focus-workspace-previous; }
    Mod+U repeat=false                  { focus-workspace-up; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }
    Mod+D repeat=false                  { focus-workspace-down; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    // Mod+1                               { focus-workspace 1; }
    // Mod+2                               { focus-workspace 2; }
    // Mod+3                               { focus-workspace 3; }
    // Mod+4                               { focus-workspace 4; }
    // Mod+5                               { focus-workspace 5; }
    // Mod+6                               { focus-workspace 6; }
    // Mod+7                               { focus-workspace 7; }
    // Mod+8                               { focus-workspace 8; }
    // Mod+9                               { focus-workspace 9; }


    /***************************************************************************
    * Move <workspace>
    ***************************************************************************/
    Mod+Shift+U { move-workspace-up; }
    Mod+Shift+D { move-workspace-down; }


    /***************************************************************************
    * Move <window> to <workspace>
    ***************************************************************************/
    Mod+Ctrl+U                               { move-window-to-workspace-up; }
    Mod+Ctrl+WheelScrollUp cooldown-ms=150   { move-window-to-workspace-up; }
    Mod+Ctrl+D                               { move-window-to-workspace-down; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-window-to-workspace-down; }
    Mod+Ctrl+1                               { move-window-to-workspace 1; }
    Mod+Ctrl+2                               { move-window-to-workspace 2; }
    Mod+Ctrl+3                               { move-window-to-workspace 3; }
    Mod+Ctrl+4                               { move-window-to-workspace 4; }
    Mod+Ctrl+5                               { move-window-to-workspace 5; }
    Mod+Ctrl+6                               { move-window-to-workspace 6; }
    Mod+Ctrl+7                               { move-window-to-workspace 7; }
    Mod+Ctrl+8                               { move-window-to-workspace 8; }
    Mod+Ctrl+9                               { move-window-to-workspace 9; }


    /***************************************************************************
    * Move <column> to <workspace>
    ***************************************************************************/
    // [...] { move-column-to-workspace-up; }
    // [...] { move-column-to-workspace 1; }
    

    /***************************************************************************
    * Focus <monitor>
    ***************************************************************************/
    Mod+Shift+Up    { focus-monitor-up; }
    Mod+Shift+K     { focus-monitor-up; }
    Mod+Shift+Down  { focus-monitor-down; }
    Mod+Shift+J     { focus-monitor-down; }
    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+H     { focus-monitor-left; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+L     { focus-monitor-right; }


    /***************************************************************************
    * Move <window> to <monitor>
    ***************************************************************************/
    Mod+Shift+Ctrl+Up    { move-window-to-monitor-up; }
    Mod+Shift+Ctrl+K     { move-window-to-monitor-up; }
    Mod+Shift+Ctrl+Down  { move-window-to-monitor-down; }
    Mod+Shift+Ctrl+J     { move-window-to-monitor-down; }
    Mod+Shift+Ctrl+Left  { move-window-to-monitor-left; }
    Mod+Shift+Ctrl+H     { move-window-to-monitor-left; }
    Mod+Shift+Ctrl+Right { move-window-to-monitor-right; }
    Mod+Shift+Ctrl+L     { move-window-to-monitor-right; }


    /***************************************************************************
    * Move <column> to <monitor>
    ***************************************************************************/
    // [...] { move-column-to-monitor-left; }


    /***************************************************************************
    * Move <workspace> to <monitor>
    ***************************************************************************/
    // [...] { move-workspace-to-monitor-left; }


    /***************************************************************************
    * Applications such as remote-desktop clients and software KVM switches may
    * request that niri stops processing the keyboard shortcuts defined here
    * so they may, for example, forward the key presses as-is to a remote machine.
    * It's a good idea to bind an escape hatch to toggle the inhibitor,
    * so a buggy application can't hold your session hostage.
    *
    * The allow-inhibiting=false property can be applied to other binds as well,
    * which ensures niri always processes them, even when an inhibitor is active.
    ***************************************************************************/
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
}
