layout {
    empty-workspace-above-first false
    gaps 16 //0
    background-color "transparent"

    default-column-width {
        proportion 0.5;
    }

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    preset-window-heights {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }


    focus-ring {
        off
    }

    // A border is similar to the focus ring, but always visible.
    // The settings are the same as for the focus ring.
    // If you enable the border, you probably want to disable the focus ring.
    // Gradients take precedence over solid colors.
    border {
        width 2
        active-gradient from="#f9a84d" to="#f7768e" angle=45 relative-to="workspace-view" in="oklch longer hue"
        inactive-gradient from="#3a3a3a" to="#555555" angle=45 relative-to="workspace-view"
        urgent-color "#f38ba8"
    }
}
